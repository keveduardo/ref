{
  "name": "reftime-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RefTime's public pages and optional backup API — reftime.brisaloca.com.",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "bash ../../_shared-assets/predeploy-guard.sh",
    "deploy": "bash ../../_shared-assets/wrangler-deploy.sh",
    "test": "node --test \"test/**/*.test.mjs\"",
    "migrate:local": "wrangler d1 migrations apply reftime --local",
    "migrate:remote": "wrangler d1 migrations apply reftime --remote"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
